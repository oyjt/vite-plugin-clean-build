{
  "name": "vite-plugin-clean-build",
  "type": "module",
  "version": "2.0.0",
  "description": "A Vite plugin that removes matching files and directories after a build.",
  "license": "MIT",
  "author": "cnpath (https://github.com/oyjt)",
  "homepage": "https://github.com/oyjt/vite-plugin-clean-build",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oyjt/vite-plugin-clean-build.git"
  },
  "bugs": {
    "url": "https://github.com/oyjt/vite-plugin-clean-build/issues"
  },
  "keywords": [
    "vite-plugin",
    "vite",
    "clean",
    "remove",
    "directory",
    "files",
    "project-clean",
    "directory-removed",
    "vite-plugin-clean"
  ],
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "unbuild",
    "prepack": "unbuild",
    "stub": "unbuild --stub",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test test/build.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "typescript": "^5.1.3",
    "unbuild": "^2.0.0",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "del": "^8.0.1"
  },
  "peerDependencies": {
    "vite": ">=3.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
